# Secrets: YouTube API keys and login tokens. NEVER commit these.
secrets/*
!secrets/README.md
client_secret*.json
token*.json
.env

# Big media files stay on your computer, not in git
photos/*
!photos/README.md
shorts/*
!shorts/README.md
*.mp4
*.mov
*.MOV
*.m4v

# Generated thumbnails (keep the originals locally)
thumbs/*
!thumbs/README.md

# Python clutter
__pycache__/
*.pyc
.venv/
venv/
.DS_Store
Thumbs.db

# Download bundle
*.zip

# Episode media: recordings, Flow visuals and renders stay on your computer
episodes/*/audio/*
episodes/*/visuals/*
episodes/*/build/*
!episodes/*/visuals/README.md
